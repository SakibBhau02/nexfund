# Copy to .env and fill in real values. Never commit .env.
# Local dev + Vercel use the same hosted Postgres (Neon, free): https://neon.tech
# Example: DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/nexfund?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/nexfund?sslmode=require
ADMIN_PASSPHRASE=change-me-to-a-long-random-string
