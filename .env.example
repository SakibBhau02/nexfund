# Copy to .env and fill in real values. Never commit .env.
# Hosted Postgres (Neon, free): https://neon.tech
# Example: DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
ADMIN_PASSPHRASE=change-me-to-a-long-random-string
# Neon S3-compatible storage (file uploads)
AWS_ENDPOINT_URL_S3="https://YOUR-BUCKET.storage.c-4.ap-southeast-1.aws.neon.tech"
AWS_ACCESS_KEY_ID="nak_live_..."
AWS_SECRET_ACCESS_KEY="nsk_live_..."
AWS_REGION="ap-southeast-1"
